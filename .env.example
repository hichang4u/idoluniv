# 이 파일을 .env.local 로 복사해 값을 채운다. .env.local 은 커밋하지 않는다.
# 운영(Vercel)에서는 프로젝트 환경변수에 같은 이름으로 넣고, 바꾼 뒤에는 재배포한다.

# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 로그인 ───────────────────────────────────────────────
# 노출할 OAuth 공급자(쉼표 구분: google,kakao,x). 베타는 google 하나 (D-2)
NEXT_PUBLIC_AUTH_PROVIDERS=google
# OAuth 복귀 주소의 기준 URL. 비우면 브라우저의 현재 origin 을 쓴다(Preview 배포 등)
NEXT_PUBLIC_SITE_URL=

# ── 법적 페이지 (/terms, /privacy, /guidelines) ──────────
# 서버 전용 값(NEXT_PUBLIC_ 아님). 페이지에 공개되는 정보다.
# 비어 있으면 페이지에 [설정 필요] 가 표시된다.

# 운영 주체: 개인 이름 또는 상호 (필수)
LEGAL_OPERATOR_NAME=
# 사업자등록번호 (선택, 사업자일 때만)
LEGAL_BUSINESS_REGISTRATION_NUMBER=
# 문의·이의 제기·탈퇴 요청 이메일 (필수)
LEGAL_CONTACT_EMAIL=
# 권리자(저작권·초상권) 신고 이메일 (선택, 비우면 문의 이메일)
LEGAL_RIGHTS_EMAIL=
# 개인정보 보호책임자 이름 (필수)
LEGAL_PRIVACY_OFFICER_NAME=
# 개인정보 보호책임자 이메일 (선택, 비우면 문의 이메일)
LEGAL_PRIVACY_OFFICER_EMAIL=
# 약관·방침 시행일 YYYY-MM-DD (필수)
LEGAL_EFFECTIVE_DATE=
# 데이터 저장 위치 — Supabase 프로젝트 리전 (필수, 예: 미국 동부(버지니아))
LEGAL_SUPABASE_REGION=
# 웹 호스팅 처리 위치 — Vercel 함수 리전 (필수, 예: 미국 동부(워싱턴 D.C.))
LEGAL_VERCEL_REGION=
